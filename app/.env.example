# Example environment for Space Hub (TRL-4)
TZ=America/Vancouver
PUBLIC_BASE_URL=http://localhost:9000

# Postgres (compose sets these as well; keep for clarity)
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub

# GOES artifact cache (shared volume path)
GOES_CACHE_PATH=/data/goes_latest.jpg
GOES_META_PATH=/data/goes_latest.json
GOES_SECTOR=pnw
