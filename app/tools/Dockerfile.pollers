FROM python:3.12-slim-bookworm
WORKDIR /work

# Keep installs resilient in flaky networks:
ENV PIP_DEFAULT_TIMEOUT=60 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir psycopg2-binary requests beautifulsoup4 lxml

COPY weather_poller.py /work/weather_poller.py
COPY notam_poller.py   /work/notam_poller.py
COPY goes_poller.py    /work/goes_poller.py
